datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String @id @default(uuid())
  email    String
  password String
  name     String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  habits       Habit[]
  transactions Transaction[]

  @@map("user")
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Habit {
  id          String   @id @default(uuid())
  name        String
  description String?
  frequency   Frequency  @default(DAILY)
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  logs   HabitLog[]

  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("habit_logs")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id              String          @id @default(uuid())
  description     String
  amount          Int
  transactionType TransactionType
  date            DateTime
  userId          String
  user            User            @relation(fields: [userId], references: [id])

  @@map("transactions")
}